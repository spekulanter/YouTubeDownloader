; Tauri-specific messages used in addition to NSIS's built-in Slovak UI.
LangString addOrReinstall ${LANG_SLOVAK} "Pridať alebo znovu nainštalovať súčasti"
LangString alreadyInstalled ${LANG_SLOVAK} "Program je už nainštalovaný"
LangString alreadyInstalledLong ${LANG_SLOVAK} "${PRODUCTNAME} ${VERSION} je už nainštalovaný. Vyberte požadovanú operáciu a pokračujte tlačidlom Ďalej."
LangString appRunning ${LANG_SLOVAK} "${PRODUCTNAME} je spustený. Zatvorte ho a skúste to znova."
LangString appRunningOkKill ${LANG_SLOVAK} "${PRODUCTNAME} je spustený.$\nKliknutím na OK ho ukončíte."
LangString chooseMaintenanceOption ${LANG_SLOVAK} "Vyberte požadovanú operáciu."
LangString choowHowToInstall ${LANG_SLOVAK} "Vyberte spôsob inštalácie programu ${PRODUCTNAME}."
LangString createDesktop ${LANG_SLOVAK} "Vytvoriť odkaz na pracovnej ploche"
LangString dontUninstall ${LANG_SLOVAK} "Aktualizovať bez odinštalovania"
LangString dontUninstallDowngrade ${LANG_SLOVAK} "Bez odinštalovania (prechod na staršiu verziu je zakázaný)"
LangString failedToKillApp ${LANG_SLOVAK} "Program ${PRODUCTNAME} sa nepodarilo ukončiť. Zatvorte ho a skúste to znova."
LangString installingWebview2 ${LANG_SLOVAK} "Inštaluje sa WebView2..."
LangString newerVersionInstalled ${LANG_SLOVAK} "V systéme je už nainštalovaná novšia verzia programu ${PRODUCTNAME}. Inštalácia staršej verzie sa neodporúča. Ak chcete pokračovať, odporúčame najprv odinštalovať aktuálnu verziu. Vyberte požadovanú operáciu a pokračujte tlačidlom Ďalej."
LangString older ${LANG_SLOVAK} "staršia"
LangString olderOrUnknownVersionInstalled ${LANG_SLOVAK} "V systéme je nainštalovaná $R4 verzia programu ${PRODUCTNAME}. Odporúčame ju pred inštaláciou odinštalovať. Vyberte požadovanú operáciu a pokračujte tlačidlom Ďalej."
LangString silentDowngrades ${LANG_SLOVAK} "Prechod na staršiu verziu je zakázaný. Tichá inštalácia nemôže pokračovať. Použite grafické rozhranie inštalačky.$\n"
LangString unableToUninstall ${LANG_SLOVAK} "Program sa nepodarilo odinštalovať."
LangString uninstallApp ${LANG_SLOVAK} "Odinštalovať ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SLOVAK} "Pred inštaláciou odinštalovať starú verziu"
LangString unknown ${LANG_SLOVAK} "neznáma"
LangString webview2AbortError ${LANG_SLOVAK} "WebView2 sa nepodarilo nainštalovať. Aplikácia ho potrebuje na spustenie. Skúste znovu spustiť inštalačku."
LangString webview2DownloadError ${LANG_SLOVAK} "Chyba pri sťahovaní inštalačného programu WebView2: $0"
LangString webview2DownloadSuccess ${LANG_SLOVAK} "Inštalačný program WebView2 bol stiahnutý."
LangString webview2Downloading ${LANG_SLOVAK} "Sťahuje sa inštalačný program WebView2..."
LangString webview2InstallError ${LANG_SLOVAK} "Inštalácia WebView2 zlyhala s kódom $1."
LangString webview2InstallSuccess ${LANG_SLOVAK} "WebView2 bol úspešne nainštalovaný."
LangString deleteAppData ${LANG_SLOVAK} "Vymazať údaje aplikácie"
